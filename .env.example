# =====================================================================
# Shared Supabase project (same as nidosnvillas — zkartpqspgpoizhuuqlv)
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://zkartpqspgpoizhuuqlv.supabase.co

# Set ONE of these (the code reads either; new name first):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TeRU6OUtDSOlK_tVRvHqZA_kZcBvhiQ
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TeRU6OUtDSOlK_tVRvHqZA_kZcBvhiQ

# Service role key — REQUIRED for the Stripe webhook to provision guest auth
# users and insert booking rows. Never expose to the browser. Get from
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Site discriminator — tags bookings/leads/coupons with this value.
NEXT_PUBLIC_SITE=vallestays

# Public URL of this deployment. Used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.vallestays.app

# =====================================================================
# Stripe — same Stripe account / API keys as nidosnvillas
# =====================================================================
# Webhook scope MUST be "Your account" (NOT "Connected accounts") — our
# Checkout Sessions are created at the platform level, not through Connect.
# Endpoint URL in Stripe dashboard:
#   https://www.vallestays.app/api/stripe/webhook
# Events to listen to:
#   checkout.session.completed
#   payment_intent.succeeded
#   payment_intent.canceled
#   payment_intent.payment_failed
STRIPE_SECRET_KEY=sk_test_or_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =====================================================================
# Resend — confirmation emails after a paid booking
# Reuse the nidosnvillas Resend account; emails come from the
# nidosnvillas.com verified domain (display name is still "Valle Stays").
# =====================================================================
RESEND_API_KEY=re_...
RESEND_FROM_GUEST=Valle Stays <concierge@nidosnvillas.com>
RESEND_FROM_HOST=Valle Stays <concierge@nidosnvillas.com>
RESEND_REPLY_TO=concierge@nidosnvillas.com
# Optional: BCC every host email to an ops inbox.
# RESEND_HOST_BCC=ops@nidosnvillas.com
